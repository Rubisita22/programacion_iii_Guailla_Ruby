# ==========================================================

# NODE.JS / NPM / YARN / PNPM

# ==========================================================

**/node_modules/
**/.npm/
**/.yarn/
**/.pnp/
**/.pnp.js
**/.pnpm-store/

# NPM

**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Lockfiles alternativos (dejar solamente el que use cada proyecto)

# **/package-lock.json

# **/yarn.lock

# **/pnpm-lock.yaml

# ==========================================================

# TYPESCRIPT

# ==========================================================

**/*.tsbuildinfo

# TypeScript compilado

**/dist/
**/build/
**/out/

# ==========================================================

# NESTJS

# ==========================================================

**/.nestjs/

# Builds de NestJS

**/dist/

# ==========================================================

# REACT

# ==========================================================

# Create React App

**/build/

# Vite

**/.vite/

# Next.js (por si algún subproyecto React utiliza Next)

**/.next/
**/out/

# React Native

**/.expo/
**/.expo-shared/

# ==========================================================

# VARIABLES DE ENTORNO

# ==========================================================

**/.env
**/.env.local
**/.env.development
**/.env.development.local
**/.env.test
**/.env.test.local
**/.env.production
**/.env.production.local

# Permitir ejemplos de variables de entorno

!**/.env.example
!**/.env.template
!**/.env.sample

# ==========================================================

# LOGS

# ==========================================================

**/*.log
**/logs/
**/log/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/lerna-debug.log*
**/pnpm-debug.log*

# ==========================================================

# COBERTURA DE TESTS

# ==========================================================

**/coverage/
**/.nyc_output/
**/.jest/

# ==========================================================

# TESTING / E2E

# ==========================================================

**/playwright-report/
**/test-results/
**/blob-report/
**/cypress/screenshots/
**/cypress/videos/
**/.cache/

# ==========================================================

# CACHÉS

# ==========================================================

**/.cache/
**/.parcel-cache/
**/.eslintcache/
**/.stylelintcache/
**/.tscache/

# ==========================================================

# IDEs / EDITORES

# ==========================================================

# Visual Studio Code

**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/extensions.json
!**/.vscode/tasks.json
!**/.vscode/launch.json

# IntelliJ / WebStorm / PhpStorm

**/.idea/
**/*.iml

# Sublime Text

**/*.sublime-workspace
**/*.sublime-project

# Eclipse

**/.project
**/.classpath
**/.settings/

# ==========================================================

# SISTEMA OPERATIVO

# ==========================================================

# Linux

**/*~
**/.directory

# macOS

**/.DS_Store
**/.AppleDouble
**/.LSOverride
**/.DocumentRevisions-V100
**/.fseventsd
**/.Spotlight-V100
**/.TemporaryItems
**/.Trashes

# Windows

**/Thumbs.db
**/Thumbs.db:encryptable
**/ehthumbs.db
**/Desktop.ini

# ==========================================================

# ARCHIVOS TEMPORALES

# ==========================================================

**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*.bak
**/*.orig

# ==========================================================

# BASES DE DATOS LOCALES

# ==========================================================

**/*.sqlite
**/*.sqlite3
**/*.db

# ==========================================================

# ARCHIVOS GENERADOS

# ==========================================================

**/generated/
**/.generated/
**/tmp/
**/temp/

# ==========================================================

# SECRETS / CREDENCIALES

# ==========================================================

**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx

# Archivos de configuración local

**/config.local.*
**/*secret*
**/*secrets*

# ==========================================================

# SERVERLESS / CLOUD

# ==========================================================

**/.serverless/
**/.webpack/
**/.aws-sam/

# ==========================================================

# DOCKER

# ==========================================================

# No ignorar Dockerfile ni docker-compose.

# Solo archivos locales generados:

**/.docker/

# ==========================================================

# MONOREPOS / WORKSPACES

# ==========================================================

**/.turbo/
**/.nx/
**/.angular/
**/.eslintcache/

# ==========================================================

# DOCUMENTACIÓN GENERADA

# ==========================================================

**/typedoc/
**/.docusaurus/

# ==========================================================

# ARCHIVOS DE DESARROLLO LOCAL

# ==========================================================

**/.local/
**/*.local.json
**/*.local.yaml
**/*.local.yml
**/*.local.xml
